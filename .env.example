# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4.6

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=["https://app.navimedic.ru", "https://navimedic.ru"]

# Application
APP_ENV=development
LOG_LEVEL=info

# Voice input feature flags — both off by default.
# VOICE_INPUT_ENABLED: backend endpoint. VITE_VOICE_INPUT_ENABLED: frontend
# UI — docker compose interpolates it from this file; for bare `npm run dev`
# put it into frontend/.env.local instead.
VOICE_INPUT_ENABLED=false
VITE_VOICE_INPUT_ENABLED=false

# Analytics dashboard access
ADMIN_TOKEN=change-me-in-production

# Telegram error alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Session expiry (hours)
SESSION_TTL_HOURS=24

# LLM cache TTL (seconds)
CACHE_TTL_CLARIFICATION=86400
CACHE_TTL_TRIAGE=604800
