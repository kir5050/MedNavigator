# LLM Provider: openrouter, yandexgpt, or gigachat
LLM_PRIMARY_PROVIDER=openrouter

# OpenRouter (for development/testing)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4.6

# YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# GigaChat
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# Application
APP_ENV=development
LOG_LEVEL=info

# Analytics dashboard access
ADMIN_TOKEN=change-me-in-production

# Session expiry (hours)
SESSION_TTL_HOURS=24

# LLM cache TTL (seconds)
CACHE_TTL_CLARIFICATION=86400
CACHE_TTL_TRIAGE=604800
